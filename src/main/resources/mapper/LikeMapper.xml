<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Config 3.0//EN"  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.instagram.mybatis.LikeMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
     INSERT INTO Likes (like_At, post_Id,user_Id)
     VALUES (#{likedAt}, #{postId}, #{userId})
    </insert>

    <select id="deleteLikeByUserAndPost">
     SELECT * FROM Likes WHERE post_id = #{postId} and user_id = #{userId}
    </select>

    <select id="countLikeForPost" resultType="int">
     SELECT COUNT(*) FROM Likes WHERE post_Id = #{postId}
    </select>

    <select id="countLikeForUser" resultType="int">
        SELECT COUNT(*) FROM Likes WHERE user_Id = #{userId}
    </select>


    <resultMap id="LikeResultMap" type="com.solvd.instagram.models.Like">
        <id property="id" column="id"/>
        <result property="likedAt" column="like_At"/>
        <result property="postId" column="post_Id"/>
        <result property="userId" column="user_Id"/>
    </resultMap>
</mapper>
